preferred-citation:
  type: conference-paper
  authors:
    - family-names: "Vidal"
      given-names: "Luis"
    - family-names: "Q-NYX Research Team"
      given-names: "Authors"
  title: "Q-NYX Fire: Deterministic Wildfire Propagation Engine, Historical Validation, and Controlled Benchmark Against FlamMap"
  conference:
    name: "XVII Congreso Internacional de Computación e Informática del Norte de Chile (INFONOR 2026)"
  year: 2026
  month: 10
  abstract: "This paper presents the scientific architecture, physical coupling, and reproducibility validation of the Q-NYX Fire simulation engine. We evaluate Rothermel surface fire rate of spread, Nelson physical dead fuel moisture equilibrium, directional Albini-Anderson vector combination on a 16-neighbor stencil Dijkstra arrival-time solver, validated over the Talamí 2017 historical wildfire domain (Chile) and benchmarked against USDA Forest Service FlamMap 6.2 Minimum Travel Time (MTT)."
