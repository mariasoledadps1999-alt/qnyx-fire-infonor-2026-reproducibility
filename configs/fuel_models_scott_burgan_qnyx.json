{
  "catalog_name": "SCOTT_BURGAN_STANDARD_FUEL",
  "provenance": {
    "source_standard": "USDA Forest Service RMRS-GTR-153 (Scott & Burgan, 2005)",
    "title": "Standard Fire Behavior Fuel Models: A Comprehensive Set for Use with Rothermel's Surface Fire Spread Model",
    "authors": "Joe H. Scott and Robert E. Burgan",
    "year": 2005,
    "table_references": ["Table 1 (Summary of fuel model parameters)", "Table 7 (Fuel model parameters for 40 standard fire behavior fuel models)"]
  },
  "unit_contract": {
    "fuel_load": {
      "source_unit": "tons/acre",
      "engine_unit": "lb/ft^2",
      "conversion_factor": 0.04591368227731864,
      "formula": "tons_acre * 2000.0 / 43560.0"
    },
    "fuel_bed_depth": {
      "source_unit": "feet",
      "engine_unit": "feet",
      "conversion_factor": 1.0,
      "formula": "identity"
    },
    "surface_area_to_volume_ratio": {
      "source_unit": "1/ft (ft^-1)",
      "engine_unit": "1/ft (ft^-1)",
      "conversion_factor": 1.0,
      "formula": "identity"
    },
    "heat_content": {
      "source_unit": "Btu/lb",
      "engine_unit": "Btu/lb",
      "conversion_factor": 1.0,
      "formula": "identity"
    },
    "moisture_of_extinction": {
      "source_unit": "percent (%)",
      "engine_unit": "dimensionless fraction (0.0 - 1.0)",
      "conversion_factor": 0.01,
      "formula": "percent / 100.0"
    },
    "particle_density": {
      "source_unit": "lb/ft^3",
      "engine_unit": "lb/ft^3",
      "default_value": 32.0
    },
    "mineral_content": {
      "total_mineral_st": 0.0555,
      "effective_mineral_se": 0.010
    }
  },
  "dynamic_fuel_contract": {
    "live_herb_curing_formula": "Scott & Burgan (2005) RMRS-GTR-153 pp. 7-8",
    "fully_green_threshold": 1.20,
    "fully_cured_threshold": 0.30,
    "transfer_fraction_formula": "(1.20 - M_lh) / 0.90",
    "transferred_fuel_destination": "dead fine fuel (evaluated at 1-h dead moisture, retaining herbaceous SAV and heat content)"
  },
  "fmc_contract": {
    "dead_1h": "1-hour timelag dead fuel moisture (< 0.25 inch), fraction",
    "dead_10h": "10-hour timelag dead fuel moisture (0.25 - 1.0 inch), fraction",
    "dead_100h": "100-hour timelag dead fuel moisture (1.0 - 3.0 inch), fraction",
    "live_herbaceous": "Live herbaceous fuel moisture, fraction (ranges 0.30 - 1.20+)",
    "live_woody": "Live woody fuel moisture, fraction (typically 0.60 - 1.50+)",
    "note": "Atmospheric RH != FMC. Direct RH -> FMC conversion is strictly prohibited."
  },
